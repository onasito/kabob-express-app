### =========================
### ORDERS
### =========================

### Create order (guest checkout - no userId)
POST http://localhost:5000/api/orders
Content-Type: application/json

{
  "customerName": "John Doe",
  "customerPhone": "702-555-1234",
  "items": [
    {
      "menuItemId": 1,
      "quantity": 2
    },
    {
      "menuItemId": 3,
      "quantity": 1
    }
  ]
}


### Create order (with userId - logged in user)
POST http://localhost:5000/api/orders
Content-Type: application/json

{
  "customerName": "Jane Smith",
  "customerPhone": "702-555-5678",
  "userId": 1,
  "items": [
    {
      "menuItemId": 1,
      "quantity": 1
    },
    {
      "menuItemId": 2,
      "quantity": 2
    },
    {
      "menuItemId": 3,
      "quantity": 1
    }
  ]
}


### Get all orders
GET http://localhost:5000/api/orders


### Get all orders filtered by status (PENDING)
GET http://localhost:5000/api/orders?status=PENDING


### Get all orders filtered by status (COMPLETED)
GET http://localhost:5000/api/orders?status=COMPLETED


### Get all orders for a specific user
GET http://localhost:5000/api/orders?userId=1


### Get all PENDING orders for a specific user
GET http://localhost:5000/api/orders?status=PENDING&userId=1


### Get order by ID
GET http://localhost:5000/api/orders/1


### Get orders by user ID (alternative endpoint)
GET http://localhost:5000/api/orders/user/1


### Update order details
PATCH http://localhost:5000/api/orders/1
Content-Type: application/json

{
  "customerName": "John Doe Updated",
  "customerPhone": "702-555-9999"
}


### Update order status to IN_PROGRESS
PATCH http://localhost:5000/api/orders/1/status
Content-Type: application/json

{
  "status": "IN_PROGRESS"
}


### Update order status to READY
PATCH http://localhost:5000/api/orders/1/status
Content-Type: application/json

{
  "status": "READY"
}


### Update order status to COMPLETED
PATCH http://localhost:5000/api/orders/1/status
Content-Type: application/json

{
  "status": "COMPLETED"
}


### Update order status to CANCELLED
PATCH http://localhost:5000/api/orders/1/status
Content-Type: application/json

{
  "status": "CANCELLED"
}


### Update order (including status in main update)
PATCH http://localhost:5000/api/orders/1
Content-Type: application/json

{
  "customerName": "John Doe",
  "customerPhone": "702-555-1234",
  "status": "READY"
}


### Delete order
DELETE http://localhost:5000/api/orders/1



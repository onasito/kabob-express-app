# Copy this file to .env and update with your local IP address
# Find your IP using: ipconfig (Windows) or ifconfig (Mac/Linux)

# For physical devices and Expo Go app, use your computer's IP address
# Example: EXPO_PUBLIC_API_URL=http://192.168.0.187:5000/api
EXPO_PUBLIC_API_URL=http://YOUR_IP_HERE:5000/api

# For Android emulator, use:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api

# For iOS simulator, use:
# EXPO_PUBLIC_API_URL=http://localhost:5000/api
